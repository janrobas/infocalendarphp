# ---------------------------------------------------------------------------
# Infomaniak Calendar MCP server — configuration
# Copy to `.env` and fill in the values. Never commit `.env`.
# ---------------------------------------------------------------------------

# Public base URL of this server, including scheme, WITHOUT trailing slash.
# ChatGPT must be able to reach this over HTTPS.
APP_URL=https://calendar.example.com

# Infomaniak CalDAV endpoint (leave as-is unless Infomaniak changes it).
INFOMANIAK_CALDAV_URL=https://sync.infomaniak.com/

# Infomaniak account login (usually your email address).
INFOMANIAK_USERNAME=

# Infomaniak "application password" (an app-specific password for sync apps).
# Generate one in the Infomaniak account settings. This is a secret.
INFOMANIAK_APP_PASSWORD=

# ---------------------------------------------------------------------------
# Mail (optional). Leave INFOMANIAK_MAIL_ADDRESS empty to disable the mail
# tools entirely.
#
# NOTE: mail uses a *device/mail password*, which is DIFFERENT from the CalDAV
# application password above. Create one in the Mail service: Mail Service ->
# the address -> Devices -> Add a device. IMAP requires SSL on port 993.
# ---------------------------------------------------------------------------
INFOMANIAK_MAIL_HOST=mail.infomaniak.com
INFOMANIAK_MAIL_PORT=993

# Full email address used as the IMAP username.
INFOMANIAK_MAIL_ADDRESS=

# The device/mail password for that address. This is a secret.
INFOMANIAK_MAIL_PASSWORD=

# ---------------------------------------------------------------------------
# Sending email (optional). Sending is OFF unless you turn it on here; while it
# is off, the send_email tool is not registered at all and the model cannot send
# anything. The same address and password as above are used to authenticate.
#
# NOTE: granting the "mail" scope to ChatGPT while sending is enabled also lets
# it send mail on your behalf.
#
# Port 587 with STARTTLS is Infomaniak's recommendation; port 465 with SSL is
# the alternative (set INFOMANIAK_SMTP_ENCRYPTION=ssl then).
# ---------------------------------------------------------------------------
INFOMANIAK_MAIL_SEND_ENABLED=0
INFOMANIAK_SMTP_HOST=mail.infomaniak.com
INFOMANIAK_SMTP_PORT=587
INFOMANIAK_SMTP_ENCRYPTION=starttls

# Save a copy of sent messages in the account's Sent mailbox. SMTP alone does
# not record sent mail, so webmail would otherwise not show it.
# Leave INFOMANIAK_MAIL_SENT_MAILBOX empty to detect the folder by name.
INFOMANIAK_MAIL_SAVE_SENT=1
INFOMANIAK_MAIL_SENT_MAILBOX=

# Limits. Sending is capped per hour to contain a runaway loop.
INFOMANIAK_MAIL_MAX_RECIPIENTS=10
INFOMANIAK_MAIL_MAX_SENDS_PER_HOUR=30

# Largest attachment, in bytes, that will be read from a PDF or attached to an
# outgoing message. Default: 10485760 (10 MB).
INFOMANIAK_MAIL_MAX_ATTACHMENT_BYTES=10485760

# The single local user for the OAuth login page.
OAUTH_USERNAME=

# Password hash for the user above. Generate with:
#   php bin/generate-password.php "your-password"
OAUTH_PASSWORD_HASH=

# OAuth token lifetimes, in seconds.
OAUTH_ACCESS_TOKEN_LIFETIME=3600
OAUTH_REFRESH_TOKEN_LIFETIME=2592000

# Set to 1 to print errors to the browser (development only). Leave 0 in prod.
APP_DEBUG=0
