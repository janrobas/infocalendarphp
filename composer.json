{
    "name": "infomaniak/mcp-calendar",
    "description": "Personal Infomaniak Calendar & Mail MCP server for ChatGPT (single-user)",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "mcp/sdk": "^0.8",
        "nyholm/psr7": "^1.8",
        "sabre/dav": "^4.6",
        "vlucas/phpdotenv": "^5.6",
        "webklex/php-imap": "^6.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite unit"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": false
        },
        "platform": {
            "php": "8.3.0"
        }
    }
}
